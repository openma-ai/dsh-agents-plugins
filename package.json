  },
  "scripts": {
    "build:core": "tsc -p tsconfig.build.json",
    "build:ui": "npm run build --workspace @openma/dsh-agents-plugins-bridge-ui",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build:owned-clients": "node scripts/build-owned-client-bundles.mjs",
    "build": "npm run build:core && npm run build:workspaces && npm run build:owned-clients",
    "prepare": "npm run build",
    "test:core": "tsx --test tests/**/*.spec.ts",
    "test": "npm run test:core && npm run test --workspaces --if-present",
    "typecheck:core": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:core && npm run typecheck --workspaces --if-present",
    "release:publish": "node scripts/publish.mjs"
  },
